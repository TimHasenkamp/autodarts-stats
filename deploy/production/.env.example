# Nach /opt/your-darts/.env kopieren, ausfuellen, chmod 600.
# Wird vom Deployment nicht ueberschrieben.

ADMIN_PASSWORD=bitte-aendern
# Fest setzen, sonst verfallen Admin-Logins bei jedem Neustart: openssl rand -hex 32
SESSION_SECRET=
TRUST_PROXY=1
# Lokaler Port fuer den Reverse-Proxy (Standard 8080)
HOST_PORT=8010

# Nur wenn Caddy im Compose-Stack das TLS-Zertifikat holen soll. Laeuft schon
# nginx o.ae. auf 80/443, beides weglassen und nginx.conf.example nutzen.
#DOMAIN=darts.your-admins.de
#COMPOSE_PROFILES=caddy

# Optional
#CHECKIN_TTL=4h
#MAX_UNPARSED=200
