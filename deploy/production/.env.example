# Nach /opt/your-darts/.env kopieren, ausfuellen, chmod 600.
# Wird vom Deployment nicht ueberschrieben.

ADMIN_PASSWORD=bitte-aendern
# Fest setzen, sonst verfallen Admin-Logins bei jedem Neustart: openssl rand -hex 32
SESSION_SECRET=
TRUST_PROXY=1

# Nur wenn Caddy im Compose-Stack das TLS-Zertifikat holen soll
# (sonst leitet dein vorhandener Reverse-Proxy auf 127.0.0.1:8080):
DOMAIN=darts.your-admins.de
COMPOSE_PROFILES=caddy

# Optional
#CHECKIN_TTL=4h
#MAX_UNPARSED=200
