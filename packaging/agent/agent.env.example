# Nach ~/.config/autodarts-stats-agent.env kopieren und ausfuellen:
#   cp /usr/share/your-darts-agent/agent.env.example ~/.config/autodarts-stats-agent.env
BACKEND_URL=https://darts.your-admins.de
API_KEY=adb_...

# Tastatur-Leser (USB-HID):   READER=evdev:/dev/input/by-id/usb-XXXX-event-kbd
# PC/SC-Leser (ACR122U u.a.): READER=pcsc
READER=pcsc

NOTIFY=auto
# Optional: tippt den Spielnamen ins fokussierte Feld (Wayland: wtype)
#TYPE_CMD=xdotool type --delay 30
