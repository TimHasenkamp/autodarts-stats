# User-Unit (laeuft in der Desktop-Session, damit notify-send und xdotool
# funktionieren). Aktivieren als der Benutzer am Board:
#   systemctl --user enable --now autodarts-stats-agent
[Unit]
Description=Your Darts Chip-Agent
After=graphical-session.target
ConditionPathExists=%h/.config/autodarts-stats-agent.env

[Service]
Type=simple
ExecStart=/usr/bin/autodarts-stats-agent
EnvironmentFile=%h/.config/autodarts-stats-agent.env
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
